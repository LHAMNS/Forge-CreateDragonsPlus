  "create_integrated_farming.ponder.roost.catch.text_2": "\u6210\u9577\u524d\u306e\u30cb\u30ef\u30c8\u30ea\u306f\u6355\u307e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u305b\u3093",
  "create_integrated_farming.ponder.roost.catch.text_3": "\u3082\u3057\u304f\u306f\u3001\u30b9\u30dd\u30ca\u30fc\u304b\u3089\u76f4\u63a5\u9ce5\u3092\u6355\u307e\u3048\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059",
  "create_integrated_farming.ponder.roost.catch.text_4": "\u30cb\u30ef\u30c8\u30ea\u5165\u308a\u5de3\u7bb1",
  "create_integrated_farming.ponder.roost.fluid.header": "\u30a2\u30a4\u30c6\u30e0\u6ce8\u6db2\u53e3\u304b\u3089\u306e\u7d66\u990c",
  "create_integrated_farming.ponder.roost.fluid.text_1": "\u4ed6\u306eMOD\u306a\u3069\u3067\u8ffd\u52a0\u3055\u308c\u305f\u9069\u5207\u306a\u6db2\u4f53\u990c\u304c\u3042\u308c\u3070\u3001\u30a2\u30a4\u30c6\u30e0\u6ce8\u6db2\u53e3\u7d4c\u7531\u3067\u30cb\u30ef\u30c8\u30ea\u306b\u990c\u3092\u4e0e\u3048\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002",
  "create_integrated_farming.ponder.roost.lead.header": "\u30ea\u30fc\u30c9\u3092\u4f7f\u3063\u305f\u5de3\u7bb1\u306e\u4f7f\u3044\u65b9",
  "create_integrated_farming.ponder.roost.lead.text_1": "\u30ea\u30fc\u30c9\u3092\u4f7f\u3063\u3066\u30cb\u30ef\u30c8\u30ea\u3092\u5de3\u7bb1\u306b\u9023\u308c\u3066\u884c\u304d\u307e\u3059",
  "create_integrated_farming.ponder.roost.lead.text_2": "\u5de3\u7bb1\u306b\u3044\u308b\u30cb\u30ef\u30c8\u30ea\u306f\u30ea\u30fc\u30c9\u3067\u5916\u306b\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059",
  "create_integrated_farming.ponder.roost.lead.text_3": "\u30cb\u30ef\u30c8\u30ea\u306e\u7d66\u990c\u3068\u30a2\u30a4\u30c6\u30e0\u306e\u53ce\u96c6\u306b\u3064\u3044\u3066\u306f\u3001\u30cb\u30ef\u30c8\u30ea\u5165\u308a\u5de3\u7bb1\u306e\u601d\u6848\u753b\u9762\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
  "create_integrated_farming.ponder.roost.raise.header": "\u30cb\u30ef\u30c8\u30ea\u306e\u98fc\u80b2",
  "create_integrated_farming.ponder.roost.raise.text_1": "\u30cb\u30ef\u30c8\u30ea\u306b\u5375\u3092\u7523\u307e\u305b\u308b\u306b\u306f\u3001\u990c\u3092\u4e0e\u3048\u306a\u3051\u308c\u3070\u3044\u3051\u307e\u305b\u3093\u3002",
  "create_integrated_farming.ponder.roost.raise.text_2": "\u30d9\u30eb\u30c8\u30b3\u30f3\u30d9\u30a2\u306b\u3088\u308a\u3001\u5de3\u7bb1\u306e\u524d\u9762\u304b\u3089\u7d66\u4ed5\u304c\u53ef\u80fd\u3067\u3059",
  "create_integrated_farming.ponder.roost.raise.text_3": "\u30e1\u30ab\u30cb\u30ab\u30eb\u30a2\u30fc\u30e0\u3067\u3082\u7d66\u990c\u3059\u308b\u3053\u3068\u304c\u51fa\u6765\u307e\u3059",
  "create_integrated_farming.ponder.roost.raise.text_4": "\u5375\u3092\u751f\u7523\u3059\u308b\u305f\u3081\u306b\u990c\u3092\u4e0e\u3048\u7d9a\u3051\u307e\u3057\u3087\u3046",
