  "block.create_integrated_farming.lava_fishing_net.tooltip.summary": "\u041a\u0430\u043a \u0438 \u043b\u0430\u0432\u043e\u0432\u0430\u044f \u0443\u0434\u043e\u0447\u043a\u0430, \u043b\u0430\u0432\u043e\u0432\u0430\u044f \u0441\u0435\u0442\u044c _\u043c\u043e\u0436\u0435\u0442 \u043b\u043e\u0432\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e_ \u0432 _\u043b\u0430\u0432\u0435_.",
  "block.create_integrated_farming.roost": "\u041d\u0430\u0441\u0435\u0441\u0442",
  "create_integrated_farming.ponder.fishing_net.header": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0440\u044b\u0431\u043e\u043b\u043e\u0432\u043d\u043e\u0439 \u0441\u0435\u0442\u0438 \u043d\u0430 \u0448\u0442\u0443\u043a\u043e\u0432\u0438\u043d\u0430\u0445",
  "create_integrated_farming.ponder.fishing_net.text_1": "\u041a\u043e\u0433\u0434\u0430 \u0440\u044b\u0431\u043e\u043b\u043e\u0432\u043d\u044b\u0435 \u0441\u0435\u0442\u0438 \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044f \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u044c \u0430\u043d\u0438\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0448\u0442\u0443\u043a\u043e\u0432\u0438\u043d\u044b...",
  "create_integrated_farming.ponder.fishing_net.text_2": "...\u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u043b\u043e\u0432\u0438\u0442\u044c \u0440\u044b\u0431\u0443 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439 \u0432\u043e\u0434\u0435, \u043a\u0430\u043a \u0438\u0433\u0440\u043e\u043a \u0441 \u0443\u0434\u043e\u0447\u043a\u043e\u0439",
  "create_integrated_farming.ponder.fishing_net.text_3": "\u0421\u0435\u0442\u044c \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0439\u043c\u0430\u0442\u044c \u043c\u0435\u043b\u043a\u0438\u0445 \u0432\u043e\u0434\u043d\u044b\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432",
  "create_integrated_farming.ponder.lava_fishing_net.header": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043b\u0430\u0432\u043e\u0432\u043e\u0439 \u0441\u0435\u0442\u0438 \u043d\u0430 \u0448\u0442\u0443\u043a\u043e\u0432\u0438\u043d\u0430\u0445",
  "create_integrated_farming.ponder.lava_fishing_net.text_1": "\u041a\u043e\u0433\u0434\u0430 \u043b\u0430\u0432\u043e\u0432\u044b\u0435 \u0441\u0435\u0442\u0438 \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044f \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u044c \u0430\u043d\u0438\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0448\u0442\u0443\u043a\u043e\u0432\u0438\u043d\u044b...",
  "create_integrated_farming.ponder.lava_fishing_net.text_2": "...\u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u043b\u043e\u0432\u0438\u0442\u044c \u0432 \u043b\u0430\u0432\u0435, \u043a\u0430\u043a \u0438\u0433\u0440\u043e\u043a \u0441 \u043b\u0430\u0432\u043e\u0432\u043e\u0439 \u0443\u0434\u043e\u0447\u043a\u043e\u0439",
  "create_integrated_farming.ponder.lava_fishing_net.text_3": "\u041b\u0430\u0432\u043e\u0432\u0430\u044f \u0441\u0435\u0442\u044c \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0439\u043c\u0430\u0442\u044c \u043c\u0435\u043b\u043a\u0438\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432 \u0432 \u043b\u0430\u0432\u0435",
  "create_integrated_farming.ponder.lightning_rod.charge_soil.header": "Charging Soil",
  "create_integrated_farming.ponder.lightning_rod.charge_soil.text_1": "Charging process of Soil to Weather Soil can be completed via Lightning Rod by Lightning Strike",
  "create_integrated_farming.ponder.roost.catch.header": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043d\u0430\u0441\u0435\u0441\u0442\u0430",
  "create_integrated_farming.ponder.roost.catch.text_1": "\u041f\u041a\u041c \u043f\u043e \u043f\u0442\u0438\u0446\u0435 \u0441 \u043f\u0443\u0441\u0442\u044b\u043c \u043d\u0430\u0441\u0435\u0441\u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0439\u043c\u0430\u0442\u044c \u0435\u0451",
  "create_integrated_farming.ponder.roost.catch.text_2": "\u041e\u0431\u044b\u0447\u043d\u043e \u043f\u0442\u0435\u043d\u0446\u043e\u0432 \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u043e\u0439\u043c\u0430\u0442\u044c",
  "create_integrated_farming.ponder.roost.catch.text_3": "\u0422\u0430\u043a\u0436\u0435 \u043f\u0442\u0438\u0446 \u043c\u043e\u0436\u043d\u043e \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u043f\u0440\u044f\u043c\u043e \u0438\u0437 \u0438\u0445 \u0440\u0430\u0441\u0441\u0430\u0434\u043d\u0438\u043a\u043e\u0432",
  "create_integrated_farming.ponder.roost.catch.text_4": "\u041d\u0430\u0441\u0435\u0441\u0442 \u0441 \u043f\u0442\u0438\u0446\u0435\u0439",
  "create_integrated_farming.ponder.roost.fluid.header": "\u041a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435\u043c \u0447\u0435\u0440\u0435\u0437 \u0434\u043e\u0437\u0430\u0442\u043e\u0440",
  "create_integrated_farming.ponder.roost.fluid.text_1": "\u041f\u0442\u0438\u0446\u0443 \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u043a\u043e\u0440\u043c\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0434\u043e\u0437\u0430\u0442\u043e\u0440, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430\u044f \u0436\u0438\u0434\u043a\u0430\u044f \u043f\u0438\u0449\u0430 (\u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u043c\u043e\u0434\u043e\u0432)",
  "create_integrated_farming.ponder.roost.lead.header": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u043e\u0432\u043e\u0434\u043a\u0430 \u0441 \u043d\u0430\u0441\u0435\u0441\u0442\u043e\u043c",
  "create_integrated_farming.ponder.roost.lead.text_1": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043f\u043e\u0432\u043e\u0434\u043e\u043a, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u0435\u0441\u0442\u0438\u0442\u044c \u043f\u0442\u0438\u0446\u0443 \u0432 \u043d\u0430\u0441\u0435\u0441\u0442",
  "create_integrated_farming.ponder.roost.lead.text_2": "\u041f\u0442\u0438\u0446\u0443 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0438\u0437 \u043d\u0430\u0441\u0435\u0441\u0442\u0430 \u043f\u043e\u0432\u043e\u0434\u043a\u043e\u043c",
  "create_integrated_farming.ponder.roost.lead.text_3": "\u041a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u043f\u0442\u0438\u0446\u044b \u0438 \u0441\u0431\u043e\u0440 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u0438, \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435 \u043a\u0443\u0440\u0438\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u0435\u0441\u0442\u0430",
  "create_integrated_farming.ponder.roost.raise.header": "\u0412\u044b\u0440\u0430\u0449\u0438\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u0442\u0438\u0446\u044b",
  "create_integrated_farming.ponder.roost.raise.text_1": "\u0414\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u0438 \u043f\u0442\u0438\u0446\u0443 \u043d\u0443\u0436\u043d\u043e \u043a\u043e\u0440\u043c\u0438\u0442\u044c",
  "create_integrated_farming.ponder.roost.raise.text_2": "\u041a\u043e\u043d\u0432\u0435\u0439\u0435\u0440\u043d\u0430\u044f \u043b\u0435\u043d\u0442\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043a\u043e\u0440\u043c\u0438\u0442\u044c \u0441 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u043d\u0430\u0441\u0435\u0441\u0442\u0430",
  "create_integrated_farming.ponder.roost.raise.text_3": "\u041c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0443\u043a\u0430 \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442 \u043a\u043e\u0440\u043c\u0438\u0442\u044c",
  "create_integrated_farming.ponder.roost.raise.text_4": "\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439\u0442\u0435 \u043a\u043e\u0440\u043c\u0438\u0442\u044c \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u0438",
  "create_integrated_farming.ponder.spout.catalyze_letios_compost.header": "\u041a\u0430\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u041b\u0435\u0442\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u0441\u0442\u0430",
  "create_integrated_farming.ponder.spout.catalyze_letios_compost.text_1": "\u041f\u0440\u043e\u0446\u0435\u0441\u0441 \u0441\u043e\u0437\u0440\u0435\u0432\u0430\u043d\u0438\u044f \u041b\u0435\u0442\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u0441\u0442\u0430 \u043c\u043e\u0436\u043d\u043e \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0434\u043e\u0437\u0430\u0442\u043e\u0440 \u0432 \u0441\u0432\u0435\u0440\u0445\u0436\u0430\u0440\u043a\u043e\u043c \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438",
  "create_integrated_farming.ponder.spout.catalyze_organic_compost.header": "\u041a\u0430\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u0441\u0442\u0430",
  "create_integrated_farming.ponder.spout.catalyze_organic_compost.text_1": "\u041f\u0440\u043e\u0446\u0435\u0441\u0441 \u0440\u0430\u0437\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u0441\u0442\u0430 \u043c\u043e\u0436\u043d\u043e \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0434\u043e\u0437\u0430\u0442\u043e\u0440",
  "create_integrated_farming.ponder.tag.farming_appliances": "\u0421\u0435\u043b\u044c\u0441\u043a\u043e\u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430",
  "create_integrated_farming.ponder.tag.farming_appliances.description": "\u041a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b \u0434\u043b\u044f \u0444\u0435\u0440\u043c\u0435\u0440\u0441\u0442\u0432\u0430",
  "create_integrated_farming.ponder.tag.fishing_appliances": "\u0420\u044b\u0431\u043e\u043b\u043e\u0432\u043d\u044b\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430",
  "create_integrated_farming.ponder.tag.fishing_appliances.description": "\u041a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b \u0434\u043b\u044f \u0440\u044b\u0431\u0430\u043b\u043a\u0438",
  "create_integrated_farming.ponder.tag.ranching_appliances": "\u0416\u0438\u0432\u043e\u0442\u043d\u043e\u0432\u043e\u0434\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430",
  "create_integrated_farming.ponder.tag.ranching_appliances.description": "\u041a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b \u0434\u043b\u044f \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430",
