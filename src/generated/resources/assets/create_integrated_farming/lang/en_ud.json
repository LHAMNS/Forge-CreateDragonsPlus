  "block.create_integrated_farming.lava_fishing_net.tooltip.summary": "\u02d9\u203e\u0250\u028c\u0250\u05df\u203e u\u0131 \u203e\u0265s\u0131\u025f\u203e \u203e\u028e\u05dfuo u\u0250\u0254\u203e \u0287\u01ddN bu\u0131\u0265s\u0131\u2132 \u0250\u028c\u0250\ua7f8 \u01dd\u0265\u0287 'po\u1d1a bu\u0131\u0265s\u0131\u2132 \u0250\u028c\u0250\ua7f8 \u01dd\u0265\u0287 \u01dd\u029e\u0131\ua7f8",
  "block.create_integrated_farming.roost": "\u0287soo\u1d1a",
  "create_integrated_farming.ponder.fishing_net.header": "suo\u0131\u0287d\u0250\u0279\u0287uo\u0186 uo \u0287\u01ddN bu\u0131\u0265s\u0131\u2132 bu\u0131s\u2229",
  "create_integrated_farming.ponder.fishing_net.text_1": "\u02d9\u02d9\u02d9uo\u0131\u0287d\u0250\u0279\u0287uo\u0186 p\u01dd\u0287\u0250\u026f\u0131u\u0250 u\u0250 \u025fo \u0287\u0279\u0250d s\u0250 p\u01dd\u028co\u026f \u01dd\u0279\u0250 s\u0287\u01ddN bu\u0131\u0265s\u0131\u2132 \u0279\u01dd\u028c\u01ddu\u01dd\u0265M",
  "create_integrated_farming.ponder.fishing_net.text_2": "po\u1d1a bu\u0131\u0265s\u0131\u2132 \u0250 \u0265\u0287\u0131\u028d bu\u0131\u0265s\u0131\u025f \u0279\u01dd\u028e\u0250\u05dfd \u0250 \u01dd\u029e\u0131\u05df '\u0279\u01dd\u0287\u0250\u028d u\u01dddo u\u0131 \u0265s\u0131\u025f \u0950\u0131\u028d \u028e\u01dd\u0265\u27d8",
  "create_integrated_farming.ponder.fishing_net.text_3": "\u0279\u01dd\u0287\u0250\u028d u\u0131 \u05df\u0250\u026f\u0131u\u0250 \u0f62\u0de7 \u0265\u0254\u0287\u0250\u0254 \u0f62\u0de7 \u0287\u01ddN bu\u0131\u0265s\u0131\u2132",
  "create_integrated_farming.ponder.lava_fishing_net.header": "suo\u0131\u0287d\u0250\u0279\u0287uo\u0186 uo \u0287\u01ddN bu\u0131\u0265s\u0131\u2132 \u0250\u028c\u0250\ua7f8 bu\u0131s\u2229",
  "create_integrated_farming.ponder.lava_fishing_net.text_1": "\u02d9\u02d9\u02d9uo\u0131\u0287d\u0250\u0279\u0287uo\u0186 p\u01dd\u0287\u0250\u026f\u0131u\u0250 u\u0250 \u025fo \u0287\u0279\u0250d s\u0250 p\u01dd\u028co\u026f \u01dd\u0279\u0250 s\u0287\u01ddN bu\u0131\u0265s\u0131\u2132 \u0250\u028c\u0250\ua7f8 \u0279\u01dd\u028c\u01ddu\u01dd\u0265M",
  "create_integrated_farming.ponder.lava_fishing_net.text_2": "po\u1d1a bu\u0131\u0265s\u0131\u2132 \u0250\u028c\u0250\ua7f8 \u0250 \u0265\u0287\u0131\u028d bu\u0131\u0265s\u0131\u025f \u0279\u01dd\u028e\u0250\u05dfd \u0250 \u01dd\u029e\u0131\u05df '\u0250\u028c\u0250\u05df u\u0131 \u0265s\u0131\u025f \u0f62\u0de7 \u028e\u01dd\u0265\u27d8",
  "create_integrated_farming.ponder.lava_fishing_net.text_3": "\u0250\u028c\u0250\u05df u\u0131 \u05df\u0250\u026f\u0131u\u0250 \u0f62\u0de7 \u0265\u0254\u0287\u0250\u0254 \u0f62 \u0287\u01ddN bu\u0131\u0265s\u0131\u2132 \u0250\u028c\u0250\ua7f8",
  "create_integrated_farming.ponder.lightning_rod.charge_soil.header": "\u05df\u0131oS bu\u0131b\u0279\u0250\u0265\u0186",
  "create_integrated_farming.ponder.lightning_rod.charge_soil.text_1": "\u01dd\u029e\u0131\u0279\u0287S bu\u0131u\u0287\u0265b\u0131\ua7f8 \u028eq po\u1d1a bu\u0131u\u0287\u0265b\u0131\ua7f8 \u0250\u0131\u028c p\u01dd\u0287\u01dd\u05dfd\u026fo\u0254 \u01ddq u\u0250\u0254 \u05df\u0131oS \u0279\u01dd\u0265\u0287\u0250\u01ddM o\u0287 \u05df\u0131oS \u025fo ss\u01dd\u0254o\u0279d bu\u0131b\u0279\u0250\u0265\u0186",
  "create_integrated_farming.ponder.roost.catch.header": "\u0287soo\u1d1a bu\u0131s\u2229",
  "create_integrated_farming.ponder.roost.catch.text_1": "\u0287\u0131 \u0265\u0254\u0287\u0250\u0254 o\u0287 \u0287soo\u0279 \u028e\u0287d\u026f\u01dd \u01dd\u0265\u0287 \u0265\u0287\u0131\u028d p\u0279\u0131q \u0250 \u029e\u0254\u0131\u05df\u0254-\u0287\u0265b\u0131\u1d1a",
  "create_integrated_farming.ponder.roost.catch.text_2": "\u0287\u0265bn\u0250\u0254 \u01ddq \u0287ouuo\u0254 sp\u0279\u0131q \u028eq\u0250q '\u028e\u05df\u05df\u0250\u0279\u01ddu\u01dd\u2141",
  "create_integrated_farming.ponder.roost.catch.text_3": "\u028e\u05df\u0287\u0254\u01dd\u0279\u0131p s\u0279\u01ddu\u028d\u0250dS \u0279\u0131\u01dd\u0265\u0287 \u026fo\u0279\u025f p\u01dd\u0287\u0254\u01dd\u05df\u05dfo\u0254 \u01ddq u\u0250\u0254 p\u0279\u0131q '\u028e\u05df\u01dd\u028c\u0131\u0287\u0250u\u0279\u01dd\u0287\u05dfx",
  "create_integrated_farming.ponder.roost.catch.text_4": "p\u0279\u0131q \u0265\u0287\u0131\u028d \u0287soo\u1d1a",
  "create_integrated_farming.ponder.roost.fluid.header": "\u0287nodS \u0250\u0131\u028c bu\u0131p\u01dd\u01dd\u2132",
  "create_integrated_farming.ponder.roost.fluid.text_1": ")spo\u026f \u0279\u01dd\u0265\u0287o \u026fo\u0279\u025f( poo\u025f p\u0131nb\u0131\u05df \u01dd\u05dfq\u0250\u0287\u0131ns s\u0131 \u01dd\u0279\u01dd\u0265\u0287 \u025f\u0131 \u0287nodS \u0250\u0131\u028c p\u01dd\u025f \u01ddq os\u05df\u0250 u\u0250\u0254 \u028e\u0279\u0287\u05dfno\u0500",
  "create_integrated_farming.ponder.roost.lead.header": "\u0287soo\u1d1a \u0265\u0287\u0131\u028d p\u0250\u01dd\ua7f8 bu\u0131s\u2229",
  "create_integrated_farming.ponder.roost.lead.text_1": "\u0287soo\u0279 \u01dd\u0265\u0287 o\u0287u\u0131 p\u0279\u0131q bu\u0131\u0279q o\u0287 p\u0250\u01dd\ua7f8 \u0250 \u01dds\u2229",
  "create_integrated_farming.ponder.roost.lead.text_2": "p\u0250\u01dd\ua7f8 \u028eq \u0287no \u0287\u0265bno\u0279q \u01ddq u\u0250\u0254 \u0287soo\u1d1a \u01dd\u0265\u0287 u\u0131 p\u0279\u0131q \u01dd\u0265\u27d8",
  "create_integrated_farming.ponder.roost.lead.text_3": "\u0287soo\u1d1a u\u01dd\u029e\u0254\u0131\u0265\u0186 \u025fo \u0279\u01ddpuo\u0500 \u01dd\u01dds 'bu\u0131\u0287\u0254\u01dd\u05df\u05dfo\u0254 \u0287\u0254npo\u0279d \u028e\u0279\u0287\u05dfnod pu\u0250 bu\u0131p\u01dd\u01dd\u025f \u028e\u0279\u0287\u05dfno\u0500",
  "create_integrated_farming.ponder.roost.raise.header": "\u028e\u0279\u0287\u05dfnod bu\u0131s\u0131\u0250\u1d1a",
  "create_integrated_farming.ponder.roost.raise.text_1": "p\u01dd\u025f \u01ddq \u0287sn\u026f \u0287\u0131 '\u01dd\u0254npo\u0279d o\u0287 \u028e\u0279\u0287\u05dfno\u0500 \u0279o\u2132",
  "create_integrated_farming.ponder.roost.raise.text_2": "\u0287soo\u1d1a \u01dd\u0265\u0287 \u025fo \u0287uo\u0279\u025f \u01dd\u0265\u0287 \u026fo\u0279\u025f bu\u0131p\u01dd\u01dd\u025f s\u028do\u05df\u05df\u0250 \u0287\u05df\u01ddq \u0279o\u028e\u01dd\u028cuo\u0186",
  "create_integrated_farming.ponder.roost.raise.text_3": "p\u01dd\u01dd\u025f os\u05df\u0250 u\u0250\u0254 \u026f\u0279\u2c6f \u05df\u0250\u0254\u0131u\u0250\u0265\u0254\u01ddW",
  "create_integrated_farming.ponder.roost.raise.text_4": "s\u0287\u0254npo\u0279d \u029e\u0254o\u0287s\u01dd\u028c\u0131\u05df \u01dd\u0254npo\u0279d o\u0287 bu\u0131p\u01dd\u01dd\u025f d\u01dd\u01dd\u029e",
  "create_integrated_farming.ponder.spout.catalyze_letios_compost.header": "\u0287sod\u026fo\u0186 so\u01dd\u0287\u01dd\ua7f8 bu\u0131z\u028e\u05df\u0250\u0287\u0250\u0186",
  "create_integrated_farming.ponder.spout.catalyze_letios_compost.text_1": "uo\u0131su\u01dd\u026f\u0131p \u026f\u0279\u0250\u028d \u0250\u0279\u0287\u05dfn u\u0131 \u0287nodS \u0250\u0131\u028c dn p\u01dd\u01ddds \u01ddq u\u0250\u0254 \u0287sod\u026fo\u0186 so\u01dd\u0287\u01dd\ua7f8 \u025fo ss\u01dd\u0254o\u0279d bu\u0131\u0287\u0287\u01ddb\u0279o\u2132",
  "create_integrated_farming.ponder.spout.catalyze_organic_compost.header": "\u0287sod\u026fo\u0186 \u0254\u0131u\u0250b\u0279O bu\u0131z\u028e\u05df\u0250\u0287\u0250\u0186",
  "create_integrated_farming.ponder.spout.catalyze_organic_compost.text_1": "\u0287nodS \u0250\u0131\u028c dn p\u01dd\u01ddds \u01ddq u\u0250\u0254 \u0287sod\u026fo\u0186 \u0254\u0131u\u0250b\u0279O \u025fo ss\u01dd\u0254o\u0279d uo\u0131\u0287\u0250p\u0250\u0279b\u01dd\u15e1",
